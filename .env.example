########################
### Atlas — Phase 0 configuration
########################

# IBM Granite 4.1 8B (Q4_K_M default) via Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=ibm/granite4.1:8b

# BeeAI uses provider:model syntax
LLM_CHAT_MODEL_NAME=ollama:ibm/granite4.1:8b

# Granite embedding model for semantic memory (pull separately for Phase 5+)
OLLAMA_EMBED_MODEL=granite-embedding:278m

BEEAI_LOG_LEVEL=INFO

########################
### Production security (optional — unset keeps localhost demo mode)
########################

# Bind MCP servers to localhost (default 127.0.0.1 when unset)
# ATLAS_BIND_HOST=127.0.0.1

# Bearer tokens — when set, MCP/A2A/API clients must send Authorization headers
# ATLAS_MCP_AUTH_TOKEN=change-me-mcp
# ATLAS_A2A_AUTH_TOKEN=change-me-a2a
# ATLAS_API_AUTH_TOKEN=change-me-api

# A2A request timeout in seconds (default 600). Raise on slow single-GPU hosts
# where the research agent's many sequential Granite calls run long.
# ATLAS_A2A_TIMEOUT=600

# Web API (FastAPI + React dashboard)
# ATLAS_API_PORT=8787
# ATLAS_VITE_PORT=5173
# ATLAS_DEV_FRONTEND_ORIGIN=http://127.0.0.1:5173
# ATLAS_API_RATE_LIMIT_RPS=10
# ATLAS_API_MAX_CONCURRENT_INFERENCES=2
# ATLAS_API_MAX_QUERY_LENGTH=2000
# ATLAS_API_PRODUCTION=1

# TLS for Rust MCP servers (PEM paths)
# ATLAS_TLS_CERT=./certs/server.crt
# ATLAS_TLS_KEY=./certs/server.key

# Disable TLS verification for local self-signed certs only
# ATLAS_TLS_INSECURE=1

# Per-IP MCP rate limit (requests per second)
# ATLAS_RATE_LIMIT_RPS=10

# MCP server ports — ATLAS_-prefixed names configure BOTH the Python clients
# and the Rust servers (legacy MCP_*_PORT names still work as fallback)
# ATLAS_MCP_MARKET_PORT=8001
# ATLAS_MCP_EDGAR_PORT=8002
ATLAS_MCP_TRADE_PORT=8003

# UN Comtrade comtrade-v1 key; blank = keyless preview (500-record cap)
ATLAS_COMTRADE_API_KEY=

# Serve curated Comtrade rows as live MCP data for demos (1=on; unset/0=real API)
# ATLAS_COMTRADE_SEED=1

# Comma-separated CORS allowlist (defaults to localhost origins)
# ATLAS_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
