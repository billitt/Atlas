########################
### Atlas — Phase 0 configuration
########################

# IBM Granite 4.1 8B (Q4_K_M default) via Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=ibm/granite4.1:8b

# BeeAI uses provider:model syntax
LLM_CHAT_MODEL_NAME=ollama:ibm/granite4.1:8b

# Granite embedding model for semantic memory (pull separately for Phase 5+)
OLLAMA_EMBED_MODEL=granite-embedding:278m

BEEAI_LOG_LEVEL=INFO
