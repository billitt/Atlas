########################
### Atlas — Phase 0 configuration
########################

# IBM Granite 4.1 8B (Q4_K_M default) via Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=ibm/granite4.1:8b

# BeeAI uses provider:model syntax
LLM_CHAT_MODEL_NAME=ollama:ibm/granite4.1:8b

# Granite embedding model for semantic memory (pull separately for Phase 5+)
OLLAMA_EMBED_MODEL=granite-embedding:278m

BEEAI_LOG_LEVEL=INFO

########################
### Production security (optional — unset keeps localhost demo mode)
########################

# Bind MCP servers to localhost (default 127.0.0.1 when unset)
# ATLAS_BIND_HOST=127.0.0.1

# Bearer tokens — when set, MCP/A2A clients must send Authorization headers
# ATLAS_MCP_AUTH_TOKEN=change-me-mcp
# ATLAS_A2A_AUTH_TOKEN=change-me-a2a

# TLS for Rust MCP servers (PEM paths)
# ATLAS_TLS_CERT=./certs/server.crt
# ATLAS_TLS_KEY=./certs/server.key

# Disable TLS verification for local self-signed certs only
# ATLAS_TLS_INSECURE=1

# Per-IP MCP rate limit (requests per second)
# ATLAS_RATE_LIMIT_RPS=10

# Comma-separated CORS allowlist (defaults to localhost origins)
# ATLAS_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
